rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function hasUserProfile() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() {
      return hasUserProfile() && getUserRole() in ['admin', 'good4Admin'];
    }
    function isBusinessUser() {
      return hasUserProfile() && getUserRole() in ['business', 'businessOwner', 'businessStaff'];
    }
    function ownsBusiness(businessId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }
    function ownsResourceBusiness(data) {
      return data.businessId is string && ownsBusiness(data.businessId);
    }
    function communityManager(id) {
      return isAuthenticated() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/community_access/$(request.auth.token.email))
        && get(/databases/$(database)/documents/community_access/$(request.auth.token.email)).data.active == true
        && id in get(/databases/$(database)/documents/community_access/$(request.auth.token.email)).data.communityIds;
    }
    function validCommunityProfile(d) {
      return d.keys().hasAll(['name', 'university', 'description', 'logoUrl', 'coverUrl'])
        && d.keys().hasOnly(['name', 'university', 'description', 'logoUrl', 'coverUrl'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.university is string && d.university.size() > 0 && d.university.size() <= 160
        && d.description is string && d.description.size() <= 1000
        && d.logoUrl is string && d.logoUrl.size() <= 2000
        && (d.logoUrl == '' || d.logoUrl.matches('https://.*'))
        && d.coverUrl is string && d.coverUrl.size() <= 2000
        && (d.coverUrl == '' || d.coverUrl.matches('https://.*'));
    }
    function validCommunityEntry(d) {
      return d.keys().hasAll(['kind','title','description','date','time','location','imageUrl','code','businessId','discountType','discountValue','totalLimit','perUserLimit','status'])
        && d.keys().hasOnly(['kind','title','description','date','time','location','imageUrl','code','businessId','discountType','discountValue','capacity','totalLimit','perUserLimit','status'])
        && d.kind in ['event', 'coupon']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() > 0 && d.description.size() <= 4000
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.time is string && (d.kind == 'coupon' || d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
        && d.location is string && d.location.size() > 0 && d.location.size() <= 200
        && d.code is string && d.code.size() <= 80 && (d.kind == 'event' || d.code == '')
        && d.businessId is string && (d.kind == 'event' || d.businessId.size() > 0)
        && d.discountType is string && d.discountType in ['percentage','fixed','freeItem']
        && d.discountValue is int && d.discountValue >= 0
        && (d.kind == 'event'
          || (d.discountType == 'percentage' && d.discountValue > 0 && d.discountValue <= 100)
          || (d.discountType == 'fixed' && d.discountValue > 0)
          || d.discountType == 'freeItem')
        && d.totalLimit is int && d.totalLimit >= 0
        && (!('capacity' in d) || (d.capacity is int && d.capacity >= 0))
        && d.perUserLimit == 1
        && d.status in ['published','pending','cancelled']
        && d.imageUrl is string && d.imageUrl.size() <= 2000
        && (d.imageUrl == '' || d.imageUrl.matches('https://.*'));
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/userTombstones/$(userId))
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'supporter', 'business'];
      allow update: if isAdmin()
        || (isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'displayName', 'phoneNumber', 'university',
            'major', 'educationLevel', 'updatedAt'
          ]))
        || (isAuthenticated()
          && request.auth.uid == userId
          && request.auth.token.email_verified == true
          && resource.data.verified != true
          && request.resource.data.verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified']))
        // Legacy reservation cancellation/creation adjusts one credit at a time.
        || (isAuthenticated()
          && request.auth.uid == userId
          && resource.data.credit is int
          && request.resource.data.credit is int
          && request.resource.data.credit >= 0
          && (request.resource.data.credit == resource.data.credit + 1
            || request.resource.data.credit == resource.data.credit - 1)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credit']))
        || (isBusinessUser()
          && resource.data.totalDonations is int
          && resource.data.totalMeals is int
          && request.resource.data.totalDonations == resource.data.totalDonations + 1
          && request.resource.data.totalMeals >= resource.data.totalMeals
          && request.resource.data.totalMeals <= resource.data.totalMeals + 100
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalDonations', 'totalMeals']));
      allow delete: if isAdmin()
        || (isAuthenticated()
          && request.auth.uid == userId
          && existsAfter(/databases/$(database)/documents/userTombstones/$(userId)));
    }

    match /userTombstones/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'deletedAt'])
        && request.resource.data.userId == userId
        && (request.resource.data.deletedAt is int || request.resource.data.deletedAt is timestamp);
      allow update, delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if true;
      // Business signup creates this document before users/{uid} exists.
      allow create: if isAuthenticated()
        && !hasUserProfile()
        && !exists(/databases/$(database)/documents/userTombstones/$(request.auth.uid))
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin()
        || (ownsBusiness(businessId)
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || ownsBusiness(businessId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || ownsResourceBusiness(request.resource.data);
      allow update: if isAdmin()
        || (ownsResourceBusiness(resource.data)
          && request.resource.data.businessId == resource.data.businessId)
        // Legacy reservation/cancellation clients adjust stock by one.
        || (isAuthenticated()
          && request.resource.data.businessId == resource.data.businessId
          && resource.data.pendingCount is int
          && request.resource.data.pendingCount is int
          && request.resource.data.pendingCount >= 0
          && (request.resource.data.pendingCount == resource.data.pendingCount + 1
            || request.resource.data.pendingCount == resource.data.pendingCount - 1)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pendingCount']));
      allow delete: if isAdmin() || ownsResourceBusiness(resource.data);
    }
    match /foodTypes/{typeId} { allow read: if true; }
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /codes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['cancelled', 'expired'])
        || (ownsResourceBusiness(resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.productId == resource.data.productId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'used');
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.supporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.supporterId == request.auth.uid
          && request.resource.data.supporterId == resource.data.supporterId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['cancelled', 'expired'])
        || (ownsResourceBusiness(resource.data)
          && request.resource.data.supporterId == resource.data.supporterId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'cancelled', 'expired']);
      allow delete: if isAdmin();
    }
    match /supportActivities/{activityId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId);
      allow delete: if isAdmin()
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
    }
    match /app_config/{documentId} {
      allow read: if documentId == 'universities' || isAuthenticated();
      allow write: if isAdmin();
    }

    match /feedbackSubmissions/{feedbackId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll([
          'userId', 'userEmail', 'userDisplayName', 'subject', 'message',
          'source', 'environment', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'userDisplayName', 'subject', 'message',
          'source', 'environment', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 320
        && request.resource.data.userDisplayName is string
        && request.resource.data.userDisplayName.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.source == 'mobile'
        && request.resource.data.environment in ['legacyTest', 'production']
        && request.resource.data.status == 'new'
        && (request.resource.data.createdAt is int || request.resource.data.createdAt is timestamp);
      allow read, update, delete: if false;
    }

    match /community_access/{email} {
      allow get: if isAuthenticated() && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow update: if communityManager(communityId) && validCommunityProfile(request.resource.data);
      allow create, delete: if false;
      match /entries/{entryId} {
        allow read: if isAuthenticated() && (resource.data.status == 'published' || communityManager(communityId));
        allow create: if communityManager(communityId) && validCommunityEntry(request.resource.data)
          && ((request.resource.data.kind == 'event' && request.resource.data.status == 'published')
            || (request.resource.data.kind == 'coupon' && request.resource.data.status == 'pending'));
        allow update: if communityManager(communityId)
          && ((request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (validCommunityEntry(request.resource.data)
              && request.resource.data.kind == resource.data.kind
              && ((request.resource.data.kind == 'event' && request.resource.data.status == 'published')
                || (request.resource.data.kind == 'coupon' && request.resource.data.status == 'pending'))));
        allow delete: if false;
        match /registrations/{userId} {
          allow get: if isAuthenticated() && (request.auth.uid == userId || communityManager(communityId));
          allow list: if communityManager(communityId);
          allow create, update: if isAuthenticated() && request.auth.uid == userId
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.kind == 'event'
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.status == 'published'
            && !exists(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)/attendance/$(userId))
            && request.resource.data.keys().hasAll(['userId','displayName','registeredAt','ticketToken'])
            && request.resource.data.keys().hasOnly(['userId','displayName','registeredAt','ticketToken'])
            && request.resource.data.ticketToken is string
            && request.resource.data.ticketToken.matches('[a-f0-9-]{36}')
            && (!exists(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)/registrations/$(userId))
              || !('ticketToken' in resource.data) || resource.data.ticketToken == ''
              || request.resource.data.ticketToken == resource.data.ticketToken)
            && request.resource.data.userId == userId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 120
            && (request.resource.data.registeredAt is int || request.resource.data.registeredAt is timestamp);
          allow delete: if isAuthenticated() && request.auth.uid == userId
            && !exists(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)/attendance/$(userId));
        }
        match /attendance/{userId} {
          allow get: if isAuthenticated() && (request.auth.uid == userId || communityManager(communityId));
          allow list: if communityManager(communityId);
          allow create: if communityManager(communityId)
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.kind == 'event'
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.status == 'published'
            && exists(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)/registrations/$(userId))
            && request.resource.data.keys().hasAll(['userId','checkedInBy','checkedInAt','method','ticketToken'])
            && request.resource.data.keys().hasOnly(['userId','checkedInBy','checkedInAt','method','ticketToken'])
            && request.resource.data.userId == userId
            && request.resource.data.checkedInBy == request.auth.uid
            && request.resource.data.checkedInAt is int
            && request.resource.data.checkedInAt > 0
            && ((request.resource.data.method == 'manual' && request.resource.data.ticketToken == '')
              || (request.resource.data.method == 'qr'
                && request.resource.data.ticketToken != ''
                && request.resource.data.ticketToken == get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)/registrations/$(userId)).data.ticketToken));
          allow update: if false;
          allow delete: if communityManager(communityId);
        }
        match /claims/{userId} {
          allow get: if isAuthenticated() && request.auth.uid == userId;
          allow list, delete: if false;
          allow create: if isAuthenticated() && request.auth.uid == userId
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.kind == 'coupon'
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.status == 'published'
            && request.resource.data.keys().hasAll(['value','userId','businessId','status','createdAt'])
            && request.resource.data.keys().hasOnly(['value','userId','businessId','status','createdAt'])
            && request.resource.data.value.matches('[0-9]{6}')
            && request.resource.data.userId == userId
            && request.resource.data.businessId == get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.businessId
            && request.resource.data.status == 'pending'
            && (request.resource.data.createdAt is int || request.resource.data.createdAt is timestamp);
          allow update: if isAuthenticated()
            && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        }
      }
      match /followers/{userId} {
        allow get: if isAuthenticated() && request.auth.uid == userId;
        allow list: if communityManager(communityId);
        allow create, update: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['userId', 'followedAt'])
          && request.resource.data.userId == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    match /community_coupon_codes/{code} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['value','communityId','entryId','userId','businessId','title','expiresOn','status','createdAt','usedAt'])
        && request.resource.data.keys().hasOnly(['value','communityId','entryId','userId','businessId','title','expiresOn','status','createdAt','usedAt'])
        && request.resource.data.value == code
        && request.resource.data.value.matches('[0-9]{6}')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.usedAt == null
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.status == 'published'
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.kind == 'coupon'
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.businessId == request.resource.data.businessId
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.title == request.resource.data.title
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.date == request.resource.data.expiresOn;
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid);
      allow list, delete: if false;
      allow update: if isAuthenticated()
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt']);
    }
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}

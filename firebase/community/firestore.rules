rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function getUserRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isAuthenticated() && getUserRole() == 'admin'; }
    function communityManager(id) {
      return isAuthenticated() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/community_access/$(request.auth.token.email))
        && get(/databases/$(database)/documents/community_access/$(request.auth.token.email)).data.active == true
        && id in get(/databases/$(database)/documents/community_access/$(request.auth.token.email)).data.communityIds;
    }
    function validCommunityProfile(d) {
      return d.keys().hasAll(['name', 'description', 'logoUrl', 'coverUrl'])
        && d.keys().hasOnly(['name', 'description', 'logoUrl', 'coverUrl'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.description is string && d.description.size() <= 1000
        && d.logoUrl is string && d.logoUrl.size() <= 2000
        && (d.logoUrl == '' || d.logoUrl.matches('https://.*'))
        && d.coverUrl is string && d.coverUrl.size() <= 2000
        && (d.coverUrl == '' || d.coverUrl.matches('https://.*'));
    }
    function validCommunityEntry(d) {
      return d.keys().hasAll(['kind','title','description','date','time','location','imageUrl','code','businessId','discountType','discountValue','totalLimit','perUserLimit','status'])
        && d.keys().hasOnly(['kind','title','description','date','time','location','imageUrl','code','businessId','discountType','discountValue','totalLimit','perUserLimit','status'])
        && d.kind in ['event', 'coupon']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() > 0 && d.description.size() <= 4000
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.time is string && (d.kind == 'coupon' || d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
        && d.location is string && d.location.size() > 0 && d.location.size() <= 200
        && d.code is string && d.code.size() <= 80 && (d.kind == 'event' || d.code == '')
        && d.businessId is string && (d.kind == 'event' || d.businessId.size() > 0)
        && d.discountType is string && d.discountType in ['percentage','fixed','freeItem']
        && d.discountValue is int && d.discountValue >= 0
        && (d.kind == 'event'
          || (d.discountType == 'percentage' && d.discountValue > 0 && d.discountValue <= 100)
          || (d.discountType == 'fixed' && d.discountValue > 0)
          || d.discountType == 'freeItem')
        && d.totalLimit is int && d.totalLimit >= 0
        && d.perUserLimit == 1
        && d.status in ['published','pending','cancelled']
        && d.imageUrl is string && d.imageUrl.size() <= 2000
        && (d.imageUrl == '' || d.imageUrl.matches('https://.*'));
    }

    // Existing Good4 development policy, excluding authorization-bearing collections.
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && collectionName != 'community_coupon_codes';
      allow write: if isAuthenticated()
        && collectionName != 'communities'
        && collectionName != 'community_access'
        && collectionName != 'community_coupon_codes';
    }
    match /businesses/{businessId} { allow read: if true; }
    match /products/{productId} { allow read: if true; }
    match /foodTypes/{typeId} { allow read: if true; }
    match /campaigns/{campaignId} { allow read: if true; }
    match /supportActivities/{activityId} { allow read: if true; }
    match /app_config/universities { allow get: if true; }

    match /community_access/{email} {
      allow get: if isAuthenticated() && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow update: if communityManager(communityId) && validCommunityProfile(request.resource.data);
      allow create, delete: if false;
      match /entries/{entryId} {
        allow read: if isAuthenticated() && (resource.data.status == 'published' || communityManager(communityId));
        allow create: if communityManager(communityId) && validCommunityEntry(request.resource.data)
          && ((request.resource.data.kind == 'event' && request.resource.data.status == 'published')
            || (request.resource.data.kind == 'coupon' && request.resource.data.status == 'pending'));
        allow update: if communityManager(communityId) && validCommunityEntry(request.resource.data)
          && request.resource.data.kind == resource.data.kind
          && ((request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (request.resource.data.kind == 'event' && request.resource.data.status == 'published')
            || (request.resource.data.kind == 'coupon' && request.resource.data.status == 'pending'));
        allow delete: if false;
        match /registrations/{userId} {
          allow get: if isAuthenticated() && (request.auth.uid == userId || communityManager(communityId));
          allow list: if communityManager(communityId);
          allow create, update: if isAuthenticated() && request.auth.uid == userId
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.kind == 'event'
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.status == 'published'
            && request.resource.data.keys().hasAll(['userId','displayName','registeredAt'])
            && request.resource.data.keys().hasOnly(['userId','displayName','registeredAt'])
            && request.resource.data.userId == userId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 120
            && (request.resource.data.registeredAt is int || request.resource.data.registeredAt is timestamp);
          allow delete: if isAuthenticated() && request.auth.uid == userId;
        }
        match /claims/{userId} {
          allow get: if isAuthenticated() && request.auth.uid == userId;
          allow list, delete: if false;
          allow create: if isAuthenticated() && request.auth.uid == userId
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.kind == 'coupon'
            && get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.status == 'published'
            && request.resource.data.keys().hasAll(['value','userId','businessId','status','createdAt'])
            && request.resource.data.keys().hasOnly(['value','userId','businessId','status','createdAt'])
            && request.resource.data.value.matches('[0-9]{6}')
            && request.resource.data.userId == userId
            && request.resource.data.businessId == get(/databases/$(database)/documents/communities/$(communityId)/entries/$(entryId)).data.businessId
            && request.resource.data.status == 'pending'
            && (request.resource.data.createdAt is int || request.resource.data.createdAt is timestamp);
          allow update: if isAuthenticated()
            && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        }
      }
      match /followers/{userId} {
        allow get: if isAuthenticated() && request.auth.uid == userId;
        allow list: if false;
        allow create, update: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['userId', 'followedAt'])
          && request.resource.data.userId == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    match /community_coupon_codes/{code} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['value','communityId','entryId','userId','businessId','title','expiresOn','status','createdAt','usedAt'])
        && request.resource.data.keys().hasOnly(['value','communityId','entryId','userId','businessId','title','expiresOn','status','createdAt','usedAt'])
        && request.resource.data.value == code
        && request.resource.data.value.matches('[0-9]{6}')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.usedAt == null
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.status == 'published'
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.kind == 'coupon'
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.businessId == request.resource.data.businessId
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.title == request.resource.data.title
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)/entries/$(request.resource.data.entryId)).data.date == request.resource.data.expiresOn;
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid);
      allow list, delete: if false;
      allow update: if isAuthenticated()
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt']);
    }
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}

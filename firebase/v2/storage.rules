rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isGood4Admin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'good4Admin';
    }

    match /home-banners/{fileName} {
      allow read: if true;
      allow write: if isGood4Admin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
